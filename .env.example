# Sao chép thành .env rồi chạy: node --env-file=.env server.js
PORT=43127
HOST=0.0.0.0
# Đường dẫn file SQLite (tự tạo thư mục). Mặc định: ./data/sanmay.db
DB_FILE=./data/sanmay.db
# Múi giờ (phút) để tính ngày/tuần của nhiệm vụ. 420 = UTC+7
TZ_OFFSET_MINUTES=420
# Đặt 1 khi chạy sau reverse proxy (nginx, Caddy…) để rate limit dùng IP thật
TRUST_PROXY=0
