      "next": "menu"
    },
    "garden-stage-1": {
      "mood": "warm",
      "lines": [
        [
          "Góc vườn cũ sạch cỏ rồi. Đất nâu thế kia là đất còn khỏe."
        ],
        [
          "Bác ra nhìn mấy lần. Dọn xong mới thấy góc ấy rộng thật."
        ]
      ],
      "next": "menu"
    },
    "garden-stage-2": {
      "mood": "warm",
      "lines": [
        [
          "Cây non lên đều lắm. Sáng nào cũng nhớ tưới một chút nhé."
        ],
        [
          "Mầm nhú lên rồi. Đừng giẫm vào luống, cháu."
        ]
      ],
      "next": "menu"
    },
    "garden-stage-3": {
      "mood": "warm",
      "lines": [
        [
          "Hoa tím nở rồi, bướm kéo về đấy. Giá có đèn đá với cái ghế thì tối ra ngắm được."
        ],
        [
          "Cháu thấy bướm không? Mấy năm rồi bác mới thấy lại."
        ]
      ],
      "next": "menu"
    },
    "garden-stage-4": {
      "mood": "calm",
      "lines": [
        [
          "Có ghế rồi đấy. Chiều nào rảnh, ra ngồi một lát."
        ],
        [
          "Tối qua bác ngồi đó tới khi đèn đá tắt. Yên lắm."
