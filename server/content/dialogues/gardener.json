    "intro": {
      "mood": "calm",
      "lines": [
        "Chào cháu. Bác là Lâm, giữ khu vườn này đã lâu.",
        "Vườn cần người chậm rãi. Cháu có vội đi đâu không?"
      ],
      "choices": [
        {
          "id": "slow",
          "text": "Không ạ, cháu muốn ngồi lại một chút.",
          "remember": {
            "key": "pace",
            "value": "slow"
          },
          "next": "intro-slow"
        },
        {
          "id": "busy",
          "text": "Cháu đang đi dạo quanh chùa.",
          "remember": {
            "key": "pace",
            "value": "walk"
          },
          "next": "intro-walk"
        }
      ]
    },
    "intro-slow": {
      "mood": "warm",
      "lines": [
        "Thế thì tốt. Ngồi bồ đoàn trên sàn gỗ kia, nghe gió qua trúc một lúc."
      ],
      "next": "intro-tips"
    },
    "intro-walk": {
      "mood": "warm",
      "lines": [
        "Đi dạo cũng là một cách ngồi yên, nếu bước chân đủ chậm."
