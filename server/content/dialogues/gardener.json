      "next": "menu"
    },
    "garden-2-seed": {
      "mood": "warm",
      "lines": [
        "Đất sạch rồi đấy. Giờ trồng gì nhỉ…",
        "Ngày trước có loài hoa dại màu tím, hạt bay vào Rừng Trúc. Phía đông rừng, dưới bóng trúc, vẫn còn mọc.",
        "Cháu tìm giúp bác ít hạt nhé."
      ]
    },
    "garden-3-bloom": {
      "mood": "warm",
      "lines": [
        "Bác thấy rồi. Hoa tím nở cả góc vườn.",
