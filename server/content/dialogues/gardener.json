      ],
      "choices": [
        {
          "id": "thanks",
          "text": "Cháu cảm ơn bác."
        }
      ]
    },
    "rain": {
      "mood": "warm",
      "lines": [
        [
          "Mưa xuống là cây mừng. Hôm nay bác khỏi phải tưới."
        ],
        [
          "Nghe mưa rơi trên lá chuối không? Bác nghe mấy chục năm rồi mà vẫn thích."
        ]
      ],
      "next": "menu"
    },
    "windy": {
      "mood": "calm",
      "lines": [
        [
          "Gió về, lá rụng nhiều. Quét rồi lại rụng, như suy nghĩ vậy."
        ],
        [
          "Hôm nay gió to, trúc kêu kẽo kẹt cả buổi."
        ]
      ],
      "next": "menu"
    },
    "noon": {
      "mood": "tired",
      "lines": [
