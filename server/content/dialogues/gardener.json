      "next": "menu"
    },
    "story": {
      "mood": "warm",
      "lines": [
        "Hồi bác mới về, góc vườn phía tây cỏ mọc ngang đầu gối.",
        "Bác dọn mỗi ngày một ô nhỏ. Ba mùa sau mới thấy lối đi."
      ],
      "next": "menu"
    },
    "pace-slow": {
      "mood": "warm",
      "lines": [
